{
  "schema": 1,
  "id": "SLES-52568",
  "name": "Crash Twinsanity",
  "product": "TwinsanityEvolved",
  "description": "Crash Twinsanity running natively on the NativeEE engine, built from the game's own code. You need your own disc; nothing from it is in this application.",
  "app_data_folder": "TwinsanityEvolved",
  "binary_name": "twinsanityevolved",
  "disc": {
    "fingerprint": {
      "file": "SLES_525.68",
      "region": "PAL",
      "id": "SLES-52568"
    },
    "alternates": [
      {
        "file": "SLUS_209.09",
        "region": "NTSC-U",
        "id": "SLUS-20909"
      }
    ],
    "extensions": [
      ".iso"
    ]
  },
  "source": {
    "url": "https://github.com/menaman123/TwinsanityEvolved",
    "toolchain": {
      "script": "tools/fetch_toolchain.sh",
      "windows_script": "tools/fetch_toolchain.ps1",
      "pins": "tools/toolchain/PINS.sha256",
      "folder": "tools/toolchain"
    },
    "ffmpeg_recipe": "engine/tools/ci/ffmpeg_static.sh",
    "needs_python": true
  },
  "targets": {
    "macos": {
      "label": "macOS",
      "host": "macos",
      "artifact": "binary",
      "configure": [
        "-G",
        "Ninja",
        "-DCMAKE_BUILD_TYPE=Release",
        "-DTE_DIST=ON",
        "-DCMAKE_PREFIX_PATH=${ffmpeg}"
      ],
      "build_target": "twinsanityevolved",
      "binary": "twinsanityevolved"
    },
    "windows": {
      "label": "Windows",
      "host": "windows",
      "artifact": "zip",
      "preset": "windows-clang-cl-release",
      "build_target": "twinsanityevolved",
      "binary": "twinsanityevolved.exe",
      "dist": {
        "script": "tools/ci/release_dist.ps1",
        "args": [
          "-SkipBuild",
          "-BuildDir",
          "${build}"
        ],
        "artifact": "dist/twinsanityevolved-windows-x64.zip"
      },
      "cross_reason": "The Windows build needs clang-cl and the Windows SDK, which exist only on Windows. Open the launcher on a Windows machine and choose Windows there; it builds a portable .zip."
    },
    "vita": {
      "label": "PS Vita",
      "host": "any",
      "artifact": "vpk",
      "preset": "vita-release",
      "build_target": "twinsanityevolved_vpk",
      "artifact_path": "twinsanityevolved.vpk",
      "needs": [
        "vitasdk"
      ],
      "install_text": "Install twinsanityevolved.vpk with VitaShell on the console (copy it to ux0:, open VitaShell, press X on the file), or open it in Vita3K on this computer (File > Install .vpk). The disc image goes to ux0:data/twinsanity/game.iso on the console, or to the same path under Vita3K's ux0 folder. The game is read from the image at run time; nothing of it is in the .vpk.",
      "unavailable_reason": "The PlayStation Vita renderer is not part of this release yet: the engine this source pins has no Vita target folder (the Vita lane stays a branch until its renderer has drawn a frame). When it is merged, this card builds twinsanityevolved.vpk; VitaSDK is then installed into your app-data folder."
    }
  },
  "run": {
    "iso_flag": "--iso",
    "config_flag": "--config",
    "memory_cards_flag": "--mc-dir",
    "args": [
      "--trace-state"
    ],
    "title_state_line": "game state @ boundary",
    "title_state_name": "Title (7)"
  },
  "settings": {
    "file": "~/.twinsanityevolved/ps2r.ini",
    "note": "Written to ~/.twinsanityevolved/ps2r.ini as the game reads it; the game's own Options menu writes the same keys.",
    "groups": [
      {
        "title": "Game",
        "rows": [
          {
            "key": "game.language",
            "label": "Language",
            "kind": "choice",
            "default": "english",
            "help": "The text, the speech and the movie sound track. The game offers every language your disc carries.",
            "choices": [
              {
                "value": "english",
                "label": "English"
              },
              {
                "value": "french",
                "label": "French"
              },
              {
                "value": "german",
                "label": "German"
              },
              {
                "value": "spanish",
                "label": "Spanish"
              },
              {
                "value": "italian",
                "label": "Italian"
              },
              {
                "value": "portuguese",
                "label": "Portuguese"
              }
            ]
          }
        ]
      },
      {
        "title": "Picture",
        "rows": [
          {
            "key": "video.aspect",
            "label": "Aspect ratio",
            "kind": "choice",
            "default": "auto",
            "help": "Auto is the TV's 4:3; the wide shapes stretch the picture the way the game's own widescreen option does.",
            "choices": [
              {
                "value": "auto",
                "label": "Auto"
              },
              {
                "value": "4:3",
                "label": "4:3"
              },
              {
                "value": "16:9",
                "label": "16:9"
              },
              {
                "value": "16:10",
                "label": "16:10"
              },
              {
                "value": "21:9",
                "label": "21:9"
              }
            ]
          },
          {
            "key": "video.scale",
            "label": "Internal scale",
            "kind": "choice",
            "default": "1",
            "help": "How many times the PlayStation 2's resolution the game is drawn at.",
            "choices": [
              {
                "value": "1",
                "label": "1x"
              },
              {
                "value": "2",
                "label": "2x"
              },
              {
                "value": "3",
                "label": "3x"
              },
              {
                "value": "4",
                "label": "4x"
              }
            ]
          },
          {
            "key": "video.texture_filter",
            "label": "Texture filter",
            "kind": "choice",
            "default": "title",
            "help": "Original is what the game asked the console for.",
            "choices": [
              {
                "value": "title",
                "label": "Original"
              },
              {
                "value": "point",
                "label": "Point"
              },
              {
                "value": "bilinear",
                "label": "Bilinear"
              }
            ]
          },
          {
            "key": "video.fullscreen",
            "label": "Window",
            "kind": "choice",
            "default": "windowed",
            "choices": [
              {
                "value": "windowed",
                "label": "Windowed"
              },
              {
                "value": "fullscreen",
                "label": "Fullscreen"
              },
              {
                "value": "borderless",
                "label": "Borderless"
              }
            ]
          },
          {
            "key": "video.vsync",
            "label": "Vertical sync",
            "kind": "switch",
            "default": "off",
            "help": "Waits for the display between frames. With a frame rate above 60 the display's refresh is the effective cap."
          },
          {
            "key": "video.frame_rate",
            "label": "Frame rate",
            "kind": "choice",
            "default": "60",
            "help": "The game always runs at its normal speed. 30 shows every other picture; 60 every picture; above 60 the frames between are interpolated. Uncapped presents every frame the renderer can make and turns vertical sync off.",
            "choices": [
              {
                "value": "30",
                "label": "30"
              },
              {
                "value": "60",
                "label": "60"
              },
              {
                "value": "120",
                "label": "120"
              },
              {
                "value": "144",
                "label": "144"
              },
              {
                "value": "240",
                "label": "240"
              },
              {
                "value": "uncapped",
                "label": "Uncapped"
              }
            ]
          },
          {
            "key": "display.fps_counter",
            "label": "FPS counter",
            "kind": "switch",
            "default": "off",
            "help": "The frames shown per second, top right, in the game's own font."
          }
        ]
      },
      {
        "title": "Mods",
        "rows": [
          {
            "key": "mods.level_select.enabled",
            "label": "Level select",
            "kind": "switch",
            "default": "off",
            "help": "A list of every level, boss and area under Options > Mods. Saves go to a separate memory card while any mod is on."
          },
          {
            "key": "mods.speedrun.enabled",
            "label": "Speedrun mode",
            "kind": "switch",
            "default": "off",
            "help": "A real-time timer at the top of the screen and practice save states (F9 / F10 / F11)."
          }
        ]
      }
    ]
  },
  "folders": {
    "games": {
      "label": "Games",
      "default": "${app_data}/Games"
    },
    "mods": {
      "label": "Mods",
      "default": "${app_data}/Mods",
      "seed_from_source": "mods"
    },
    "memory_cards": {
      "label": "Memory cards",
      "default": "~/.twinsanityevolved/memcards"
    },
    "game_output": {
      "label": "Game folder",
      "default": "~/Desktop/Crash Twinsanity"
    }
  },
  "scan": {
    "folders": [
      "~/Downloads",
      "~/Desktop",
      "~/Documents",
      "${games}"
    ],
    "removable": true,
    "max_depth": 2
  },
  "licences": [
    {
      "label": "MIT licence",
      "path": "LICENSE"
    }
  ]
}
